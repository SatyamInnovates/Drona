{
  "name": "drona-activity-tracker",
  "displayName": "Drona Activity Tracker",
  "description": "Automatically tracks coding time per project inside VS Code.",
  "version": "0.0.2",
  "publisher": "satyam-cde",
  "engines": {
    "vscode": "^1.121.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "drona-activity-tracker.toggleTracking",
        "title": "Drona Activity Tracker: Toggle Tracking"
      }
    ],
    "configuration": {
      "title": "Drona Activity Tracker",
      "properties": {
        "dronaActivityTracker.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Local Drona dashboard server URL."
        },
        "dronaActivityTracker.idleMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 30,
          "description": "Minutes after the last code edit before coding time stops counting."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.121.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
